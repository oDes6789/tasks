{
  "name": "tochuc-giaovien",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/kill-port.ts 3000 && tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "NODE_ENV=production node dist/server.js",
    "db:migrate": "tsx server/runMigrate.ts",
    "db:setup": "tsx server/runMigrate.ts",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-vue": "^5.2.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "4.5.5",
    "vite": "^6.2.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vue-tsc": "^2.2.10"
  }
}
