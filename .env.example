# Edutalk OAuth — API xác minh token / đổi code (server-side)
# Dùng 127.0.0.1 thay vì localhost — Node trên Windows có thể resolve localhost → IPv6 (::1)
EDUTALK_API_URL=http://127.0.0.1:8000
OAUTH_CLIENT_ID=tochuc-giaovien
OAUTH_CLIENT_SECRET=change-me
OAUTH_REDIRECT_URI=http://localhost:3000/dang-nhap/callback

# Khóa ký phiên đăng nhập
SESSION_SECRET=change-me-in-production

# Port server
PORT=3000

# Edutalk OAuth — cổng noibo xác nhận quyền (client-side, Vite)
VITE_NOIBO_URL=http://127.0.0.1:8080/
# VITE_OAUTH_CLIENT_ID=tochuc-giaovien
# VITE_OAUTH_REDIRECT_URI=http://localhost:3000/dang-nhap/callback
